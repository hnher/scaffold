{
  "name": "scaffold",
  "version": "1.0.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=12 <13"
  },
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "types:check": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production --local --non-interactive --output ./builds/app.ipa",
    "build:android": "eas build --platform android --profile production --local --non-interactive --output ./builds/app.apk"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-insights": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.20",
    "lucide-react-native": "^1.33.0",
    "nativewind": "5.0.0-rc.0",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
