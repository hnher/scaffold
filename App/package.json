{
  "name": "scaffold",
  "version": "1.0.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production --local --non-interactive --output ./builds/app.ipa",
    "build:android": "eas build --platform android --profile production --local --non-interactive --output ./builds/app.apk"
  },
  "dependencies": {
    "@expo/config-plugins": "~56.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "expo": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.24",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.25",
    "expo-device": "~56.0.4",
    "expo-insights": "~56.0.24",
    "expo-linking": "~56.0.17",
    "expo-notifications": "~56.0.24",
    "expo-router": "~56.2.19",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.25",
    "lucide-react-native": "^1.33.0",
    "nativewind": "preview",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css": "latest",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "private": true
}
