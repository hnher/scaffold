{
    "$schema": "./scaffold.schema.json",
    "version": 1,
    "applications": [
        {
            "id": "console",
            "label": "Laravel、Web 与管理后台",
            "path": "Console",
            "environment": {
                "source": ".env.example",
                "target": ".env"
            },
            "composer": true,
            "node": true,
            "build": "build",
            "laravel": {
                "artisan": "artisan",
                "database": "database/database.sqlite",
                "migrate": true
            }
        },
        {
            "id": "app",
            "label": "React Native App",
            "path": "App",
            "environment": {
                "source": ".env.example",
                "target": ".env"
            },
            "composer": false,
            "node": true
        },
        {
            "id": "applet",
            "label": "uni-app 小程序",
            "path": "Applet",
            "environment": {
                "source": ".env.example",
                "target": ".env"
            },
            "composer": false,
            "node": true
        }
    ],
    "manualConfiguration": [
        "App/app.json 中的 Bundle Identifier 与 Android package，并通过 eas init 关联自己的 Expo 项目",
        "App/eas.json 中的应用提交账号与平台应用标识",
        "Android 推送所需的 App/google-services.json、expo.android.googleServicesFile 与 EAS FCM 凭据（不提交私钥）",
        "Applet/src/manifest.json 中的应用信息",
        "Applet/.env 中的 WECHAT_APP_ID 与 WECHAT_PRIVATE_KEY_PATH（私钥不提交到 Git）",
        "Console/.env 中可选的 SEED_ADMIN_EMAIL 与 SEED_ADMIN_PASSWORD，用于初始化管理员"
    ]
}
